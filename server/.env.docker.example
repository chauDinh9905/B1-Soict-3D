# Dùng khi chạy cả API trong Docker: `docker compose --profile full up --build`
# Chép thành .env.docker (không commit). Tên máy là tên service trong compose.yaml.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://tour:tour@postgres:5432/tour
REDIS_URL=redis://redis:6379
SESSION_SECRETS=doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai-hon-32-ky-tu
TRUST_PROXY=loopback
APP_ORIGINS=http://localhost:5173
RUN_MIGRATIONS=true
CONTENT_DIR=/app/content
LOG_LEVEL=info
