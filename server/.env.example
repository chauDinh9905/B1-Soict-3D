# Chép thành .env rồi sửa (KHÔNG commit .env). Mọi biến được kiểm tra ở src/config.js.
#   Linux/Git Bash: cp .env.example .env      PowerShell: Copy-Item .env.example .env
NODE_ENV=development
PORT=3000

# Postgres và Redis chạy bằng `docker compose up -d` ở thư mục gốc repo
DATABASE_URL=postgres://tour:tour@localhost:5432/tour
PG_POOL_MAX=10
REDIS_URL=redis://localhost:6379

# Khóa ký cookie phiên: chuỗi ngẫu nhiên >= 32 ký tự. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Đổi khóa: thêm khóa MỚI lên đầu, giữ khóa cũ phía sau một thời gian (ngăn cách bởi dấu phẩy).
SESSION_SECRETS=doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai-hon-32-ky-tu

# Số lớp proxy phía trước (dev: loopback; sau Vercel + host: thường 1 hoặc 2 – đo req.ip để chỉnh)
TRUST_PROXY=loopback
# Các Origin được phép gửi request ghi dữ liệu. Dấu * thay cho một đoạn chữ/số/gạch (link Preview của Vercel)
APP_ORIGINS=http://localhost:5173

# true = tự chạy migration khi khởi động (tiện khi dev). Production: chạy `npm run migrate` thành bước riêng.
RUN_MIGRATIONS=true
CONTENT_DIR=../web/public/data
LOG_LEVEL=info

# TẠM THỜI – token quản trị cũ, xóa sau khi trang admin chuyển sang đăng nhập (tuần 8)
ADMIN_TOKEN=
